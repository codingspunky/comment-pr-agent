# ---- GitHub auth ----
# EITHER a pre-minted token (GitHub Actions injects one; repo-scoped, expires
# with the job — this is the safest option and skips App auth entirely):
# GITHUB_TOKEN=ghs_...
#
# OR a GitHub App (needed for the webhook service):
GITHUB_APP_ID=
# Point this at your App's .pem. Left unset on purpose: a default path that does
# not exist on your machine fails later and less clearly than no path at all.
# GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/app-private-key.pem
GITHUB_APP_PRIVATE_KEY_PATH=
# GITHUB_APP_PRIVATE_KEY_B64=LS0tLS1CRUdJTiBSU0Eg...
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# REQUIRED for the webhook service. The service refuses to start without it:
# an empty secret means every request is HMAC'd with an empty key, which anyone
# can reproduce. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(24))"
GITHUB_WEBHOOK_SECRET=

# ---- LLM (Groq) ----
GROQ_API_KEY=
AGENT_MODEL=qwen/qwen3.6-27b
# qwen/qwen3.6-27b: 131,072 context, 16,384 MAX OUTPUT TOKENS, tool use, vision,
# and dual-mode reasoning. The output ceiling is the binding constraint for this
# agent, not the context window -- the edit call must emit complete file bodies.
# Alternatives on Groq: openai/gpt-oss-120b (32,766 output), qwen/qwen3-32b.
# Confirm current IDs:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
#
# Clamped at startup to the model's published ceiling (agent/config.py
# MODEL_LIMITS), so a value copied from a bigger model degrades instead of 400ing.
AGENT_MAX_TOKENS=12000
# 0.6 = the provider's recommendation for PRECISE CODING in thinking mode.
# Do NOT drop this toward 0: near-greedy sampling makes Qwen's thinking mode
# repeat itself, which spends the completion budget before the answer arrives.
AGENT_TEMPERATURE=0.6
AGENT_TOP_P=0.95
AGENT_LLM_TIMEOUT=120

# ---- Reasoning (thinking) mode ----
# Thinking tokens are charged against the SAME ceiling as the answer, so the mode
# is per call:
#   AGENT_REASONING_EFFORT      -> interpret + plan. Small outputs, real judgement.
#   AGENT_EDIT_REASONING_EFFORT -> the edit call. 'none' on purpose: its output is
#       complete file bodies and it may not shrink its budget, so a thinking trace
#       competes directly with the code and invites a half-written file.
# Values: none | low | medium | high | default. Empty = omit the parameter (for a
# gateway that does not implement it).
AGENT_REASONING_EFFORT=default
AGENT_EDIT_REASONING_EFFORT=none
# hidden = drop the trace; parsed = separate field. Never 'raw': that leaves
# <think> blocks in message.content, which is where tool arguments come from.
AGENT_REASONING_FORMAT=hidden

# Per-call completion budgets. These were hardcoded at 1000 / 2000, which is a
# non-reasoning-model assumption: with thinking on, the trace alone overruns 1000
# tokens and every run failed at the interpret step.
AGENT_INTERPRET_MAX_TOKENS=4000
AGENT_PLAN_MAX_TOKENS=6000

# ---- Behaviour ----
AGENT_TRIGGER=/agent
# true = the comment must START A LINE with the trigger to reach the LLM.
# false = every comment is routed to the LLM (costs an LLM call per comment).
AGENT_REQUIRE_TRIGGER=true
AGENT_MAX_RETRIES=3
AGENT_DEFAULT_REVIEWERS=
AGENT_AUTHOR_ALLOWLIST=
AGENT_GIT_NAME=comment-agent[bot]
AGENT_GIT_EMAIL=comment-agent[bot]@users.noreply.github.com

# ---- Validation ----
# LEAVE THIS EMPTY unless you have one target repo and only one. This setting is
# global to the agent installation, so a command tuned for one repository is
# applied to every repository the agent touches -- point it at a second repo and
# validation fails for reasons unrelated to the edit.
#
# Empty means auto-detection (agent/detect.py) works it out per repo:
#   requirements.txt / pyproject.toml / setup.py  -> pip install + pytest
#   package.json                                  -> npm ci|install + npm test
#   go.mod                                        -> go test ./...
#   Cargo.toml                                    -> cargo test
#   Makefile with a `test:` target                -> make test
# Root first, then one directory down, so a project in a subdirectory is found.
AGENT_VALIDATE_CMD=

# Detected Python validation installs the target repo's dependencies. In a
# throwaway virtualenv by default, for two reasons: a repo's pins would
# otherwise collide with the agent's own groq/langgraph, and a repo that imports
# something the AGENT happens to have installed would pass validation without
# declaring it -- a false green, which is the exact failure the PR footer exists
# to prevent. Set false to trade that correctness for speed.
AGENT_ISOLATED_VALIDATE=true
# Budget for building the venv and installing dependencies, separate from the
# test suite's own timeout.
AGENT_VALIDATE_SETUP_TIMEOUT=300
AGENT_VALIDATE_TIMEOUT=900
AGENT_SKIP_VALIDATION_IF_UNKNOWN=true
# Allow a repo-committed skill (or .agent.yml) to supply the shell command that
# runs on this host. OFF by default: on a long-lived server it escalates "can
# commit to a branch" into "can run code where the App private key lives",
# which mints tokens for EVERY installation. Safe to enable on an ephemeral
# GitHub Actions runner, where the token is already scoped to one repo.
AGENT_ALLOW_REPO_VALIDATE_CMD=false

# ---- Context budget ----
# max_file_chars is clamped at startup so any file that passes the read cap can
# also be re-emitted in full by the edit call. Raising AGENT_MAX_TOKENS raises
# the usable ceiling; setting this above what the completion budget supports
# has no effect.
AGENT_MAX_TARGET_FILES=8
AGENT_MAX_FILE_CHARS=20000
# The PR diff shown to the planner. ~2,300 tokens at 8000 chars — a third of a
# small TPM budget, for context the planner barely uses on a small repo.
AGENT_MAX_DIFF_CHARS=8000

# ---- Rate limits ----
# Retries for transient provider errors (429/5xx), separate from validation
# retries. The agent reads the provider's retry-after header, so a 429 waits the
# amount the server actually asked for (capped at 75s) instead of a fixed 8.
AGENT_MAX_TRANSIENT_RETRIES=5

# ---- Cost visibility (optional) ----
# Unset by default: provider prices change, and a stale table compiled into
# source reports confident wrong numbers. Fill from the pricing page to get an
# estimate on the run-summary log line. Token counts are always logged.
# AGENT_PRICE_INPUT_PER_M=0.60
# AGENT_PRICE_OUTPUT_PER_M=3.00

# ---- Persistence (optional) ----
# DATABASE_URL=postgresql://user:pass@host:5432/agent

AGENT_WORKDIR=/tmp/comment-pr-agent

# ---- .env loading ----
# This file is read ONLY from operator-controlled locations: $AGENT_ENV_FILE if
# set, otherwise a .env sitting beside the installed `agent` package. It is
# never searched for relative to the current working directory, because under
# GitHub Actions that directory is the TARGET repository — a .env committed
# there could redirect GROQ_BASE_URL / GITHUB_API_BASE to a host that then
# receives our Authorization header, or set AGENT_VALIDATE_CMD, bypassing
# AGENT_ALLOW_REPO_VALIDATE_CMD entirely.
# AGENT_ENV_FILE=/run/secrets/agent.env
# Set to 1 in containers, which should receive real environment variables:
# AGENT_NO_DOTENV=0
