# Free-tier profile — small repositories only.
#
#   cp .env.free-tier .env     (then fill in the secrets below)
#
# ---------------------------------------------------------------------------
# FIRST: find out what your actual TPM is. Published figures disagree across
# trackers and are per model. The response headers are the only truth:
#
#   curl -si https://api.groq.com/openai/v1/chat/completions \
#     -H "Authorization: Bearer $GROQ_API_KEY" -H "Content-Type: application/json" \
#     -d '{"model":"qwen/qwen3.6-27b","messages":[{"role":"user","content":"hi"}],
#          "max_completion_tokens":10}' | grep -i "x-ratelimit\|retry-after"
#
# `x-ratelimit-limit-tokens` is your TPM. This file assumes a pessimistic 6,000.
# If yours is higher, raise the budgets below proportionally.
# ---------------------------------------------------------------------------
#
# THE ARITHMETIC THIS FILE EXISTS FOR
#
# The provider charges prompt + REQUESTED max_completion_tokens against TPM —
# the requested budget is billed whether or not it is used. The shipped defaults
# are sized for a paid tier and break a 6K minute on their own:
#
#   call        prompt   requested   charged
#   interpret    ~300      4,000      4,300
#   plan         ~600      6,000      6,600   <- over
#   edit       ~1,700     12,000     13,700   <- over by 2x
#
# With this profile, on a repo the size of `aiops`:
#
#   interpret    ~300        800      1,100
#   plan         ~600      1,200      1,800
#   edit       ~1,700      3,000      4,700
#                                   -------
#                          total     ~7,600 per run
#
# Still more than one 6K minute, so a 429 mid-run is NORMAL here, not a fault.
# That is survivable only because the agent now reads the provider's retry-after
# header instead of capping its wait at 8 seconds. Do not lower
# AGENT_MAX_TRANSIENT_RETRIES.
#
# Daily: ~7,600 tokens/run against a 100–200K TPD cap is 13–26 runs a day, and a
# FAILED run costs the same as a successful one. Budget accordingly.
# ---------------------------------------------------------------------------

# ---- Secrets (fill these in) ----
GROQ_API_KEY=
GITHUB_APP_ID=
# e.g. GITHUB_APP_PRIVATE_KEY_PATH=/c/Users/you/keys/app.pem
GITHUB_APP_PRIVATE_KEY_PATH=
# Generate: python -c "import secrets; print(secrets.token_hex(24))"
GITHUB_WEBHOOK_SECRET=

# ---- Model ----
AGENT_MODEL=qwen/qwen3.6-27b

# ---- Thinking: OFF ----
# This is the whole profile in one setting. Reasoning tokens are charged against
# the same ceiling as the answer, and thinking is what forced the large per-call
# budgets. Without it the small budgets below become viable again.
#
# You are trading planning quality for feasibility. On a two-file repository that
# is a good trade; on a large one, thinking off means worse file selection, and
# the answer is a paid tier rather than a smaller budget.
AGENT_REASONING_EFFORT=none
AGENT_EDIT_REASONING_EFFORT=none
AGENT_REASONING_FORMAT=hidden

# Non-thinking sampling, per the provider's recommendation.
# NOTE: that recommendation also lists presence_penalty=1.5. It is deliberately
# NOT applied here — it is tuned for dialogue, and penalising repeated tokens
# while emitting whole source files fights against indentation, imports and
# keywords. This agent does not send it.
AGENT_TEMPERATURE=0.7
AGENT_TOP_P=0.8

# ---- Budgets ----
AGENT_INTERPRET_MAX_TOKENS=800
AGENT_PLAN_MAX_TOKENS=1200
AGENT_MAX_TOKENS=3000

# Clamped at startup to max_tokens * 3.5 * 0.75 = 7,875, so 6000 survives intact
# and any file that passes the read cap can still be re-emitted in full.
#
# This was 4000, which is below the size of an ORDINARY source file: a 4,053
# character module was refused outright with "too large", and the run cost a
# plan call to find that out. 6000 covers the common case and still leaves
# 1,875 characters of headroom under the clamp, so nothing is silently reduced.
AGENT_MAX_TARGET_FILES=2
AGENT_MAX_FILE_CHARS=6000
AGENT_MAX_DIFF_CHARS=2000

# Each retry is another full edit call — the most expensive one there is.
AGENT_MAX_RETRIES=1
# 429s are routine at this budget. This is the setting that lets a run finish.
AGENT_MAX_TRANSIENT_RETRIES=6

# ---- Validation ----
# LEAVE THIS EMPTY unless you have one target repo and only one. This setting is
# global to the agent installation, so a command tuned for one repository is
# applied to every repository the agent touches -- point it at a second repo and
# validation fails for reasons unrelated to the edit.
#
# Empty means auto-detection (agent/detect.py) works it out per repo:
#   requirements.txt / pyproject.toml / setup.py  -> pip install + pytest
#   package.json                                  -> npm ci|install + npm test
#   go.mod                                        -> go test ./...
#   Cargo.toml                                    -> cargo test
#   Makefile with a `test:` target                -> make test
# Root first, then one directory down, so a project in a subdirectory is found.
AGENT_VALIDATE_CMD=

# Detected Python validation installs the target repo's dependencies. In a
# throwaway virtualenv by default, for two reasons: a repo's pins would
# otherwise collide with the agent's own groq/langgraph, and a repo that imports
# something the AGENT happens to have installed would pass validation without
# declaring it -- a false green, which is the exact failure the PR footer exists
# to prevent. Set false to trade that correctness for speed.
AGENT_ISOLATED_VALIDATE=true
# Budget for building the venv and installing dependencies, separate from the
# test suite's own timeout.
AGENT_VALIDATE_SETUP_TIMEOUT=300
AGENT_VALIDATE_TIMEOUT=900
AGENT_SKIP_VALIDATION_IF_UNKNOWN=true
AGENT_ALLOW_REPO_VALIDATE_CMD=false

# ---- Cost visibility (optional) ----
# Unset by default so no stale price is ever reported as fact. Fill from the
# provider's current pricing page to get an estimate in the run-summary log line.
# AGENT_PRICE_INPUT_PER_M=0.60
# AGENT_PRICE_OUTPUT_PER_M=3.00

# ---- Behaviour ----
AGENT_TRIGGER=/agent
AGENT_REQUIRE_TRIGGER=true
AGENT_GIT_NAME=comment-agent[bot]
AGENT_GIT_EMAIL=comment-agent[bot]@users.noreply.github.com
AGENT_WORKDIR=/tmp/comment-pr-agent
